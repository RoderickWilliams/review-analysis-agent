# ReviewAgent 环境变量示例（复制为 .env 后填写真实值）
# 必填：一个或多个 OpenAI 兼容 API Key，逗号分隔或 JSON 数组；支持轮换
REVIEWAGENT_API_KEYS=your-key-1,your-key-2

# 可选：模型与网关（默认 gpt-4o + 官方地址）
REVIEWAGENT_MODEL=gpt-4o
# REVIEWAGENT_BASE_URL=https://api.deepseek.com/v1

# 可选：数据与输出目录（默认仓库根/data、仓库根/output）
# REVIEWAGENT_HOME=E:\DeepSeek\review-agent
# REVIEWAGENT_OUTPUT_DIR=E:\DeepSeek\review-agent\output

# 可选：LLM 缓存（默认开启；0/false/no/off 关闭）
# REVIEWAGENT_LLM_CACHE=0

# 可选：评论采集（默认关闭；开启前确认目标站点的使用条款）
# REVIEWAGENT_ENABLE_SCRAPING=1
# REVIEWAGENT_SCRAPER_BACKEND=legacy          # legacy | scrapling
# REVIEWAGENT_SCRAPLING_SELECTORS=config/scrapling_selectors.json
# REVIEWAGENT_SCRAPLING_MODE=auto             # auto | http | stealth
# REVIEWAGENT_SCRAPLING_TIMEOUT=30

# 服务访问令牌：非本机监听时必须配置；由你在运行环境设置，不随发行包分发
# REVIEWAGENT_ACCESS_TOKEN=
# 单进程任务调度，单条并发默认 2，可设 1–8
# REVIEWAGENT_ANALYSIS_WORKERS=2
# 旧 JSON 历史迁移默认关闭；备份后设为 1 才显式迁移
# REVIEWAGENT_MIGRATE_LEGACY_HISTORY=0

# Platform browser: auto, edge, chrome, firefox; direct affects platform reads only.
REVIEWAGENT_BROWSER=auto
REVIEWAGENT_BROWSER_NETWORK=direct
