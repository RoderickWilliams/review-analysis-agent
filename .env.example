# ═══════════════════════════════════════════════════════════════
# 环境变量配置模板（复制为 .env 并填入真实值）
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# LLM 调用模式
# ═══════════════════════════════════════════════════════════════

# LLM 调用模式: api（使用 API Key）或 web（使用网页版 access_token）
# api 模式: 填入下方 LLM_API_KEYS
# web 模式: 填入下方 OPENAI_ACCESS_TOKEN 或 OPENAI_EMAIL/OPENAI_PASSWORD
LLM_MODE=api

# ═══════════════════════════════════════════════════════════════
# API 模式配置（LLM_MODE=api 时使用）
# ═══════════════════════════════════════════════════════════════

# LLM 模型
LLM_MODEL=gpt-4o

# API Base URL（留空使用 OpenAI 官方，或填入第三方兼容平台地址）
LLM_BASE_URL=

# API Keys（多个Key轮换，用逗号分隔）
LLM_API_KEYS=sk-your-api-key-1,sk-your-api-key-2

# ═══════════════════════════════════════════════════════════════
# Web 模式配置（LLM_MODE=web 时使用，无需 API Key）
# 移植自 https://github.com/zhuweiyou/chatgpt-api
# ═══════════════════════════════════════════════════════════════

# 方式一: 手动获取的 access_token（优先使用）
# 获取方法: 登录 chat.openai.com → F12 → Network → /api/auth/session → 复制 accessToken
OPENAI_ACCESS_TOKEN=

# 方式二: 通过账号密码自动获取 access_token（不支持谷歌/微软授权登录）
OPENAI_EMAIL=
OPENAI_PASSWORD=

# 反向代理 URL（用于绕过 Cloudflare 人机验证）
REVERSE_PROXY_URL=https://ai.fakeopen.com/api/conversation

# 独立代理服务 URL（可选，指向 web_proxy_server.py）
# WEB_PROXY_SERVER_URL=http://localhost:3000

# 认证服务 URL（用于获取 access_token）
AUTH_SERVICE_URL=https://chatgpt-auth.vercel.app/api
